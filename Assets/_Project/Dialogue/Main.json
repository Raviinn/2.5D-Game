>":".^.s0","c":true},"ev","du",1,"==","/ev",{"->":".^.s1","c":true},"ev","du",2,"==","/ev",{"->":".^.s2","c":true},"nop",{"s0":["pop","^Sit, sit. You look like you walked through a hedge.",{"->":".^.^.23"},null],"s1":["pop","^There's tea if you want it. It's mostly nettle.",{"->":".^.^.23"},null],"s2":["pop","^Back again, ","ev",{"x()":"player_name"},"out","/ev","^? Show me those hands.",{"->":".^.^.23"},null],"#f":5}],"\n",{"->":"maren.17"},null]}],"nop","\n",{"->":".^.menu"},{"menu":[["ev","str","^Could you see to my wounds?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^What do you have for sale?","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^Do you need help with anything?","/str","str","^quest_herbsformaren","/str",{"x()":"quest_state","exArgs":1},"str","^inactive","/str","==","/ev",{"*":".^.c-2","flg":5},"ev","str","^About the Healroot...","/str","str","^quest_herbsformaren","/str",{"x()":"quest_state","exArgs":1},"str","^active","/str","==","/ev",{"*":".^.c-3","flg":5},"ev","str","^Goodbye.","/str","/ev",{"*":".^.c-4","flg":4},{"c-0":["\n","ev",{"x()":"heal_player"},"pop","/ev","\n","^Maren: ",["ev","visit",3,"seq","/ev","ev","du",0,"==","/ev",{"->":".^.s0","c":true},"ev","du",1,"==","/ev",{"->":".^.s1","c":true},"ev","du",2,"==","/ev",{"->":".^.s2","c":true},"nop",{"s0":["pop","^There. Clean, bound, and you'll scar handsomely.",{"->":".^.^.23"},null],"s1":["pop","^Bite your sleeve. Done. Next time, duck.",{"->":".^.^.23"},null],"s2":["pop","^Nothing a little Healroot salve can't settle.",{"->":".^.^.23"},null],"#f":5}],"\n",{"->":".^.^.^"},null],"c-1":["\n","^Maren: Remedies, mostly. Don't drink them all at once.","\n","ev",{"x()":"open_shop"},"pop","/ev","\n","end",null],"c-2":["\n",{"->":"maren.herbs_offer"},null],"c-3":["\n","^Maren: Three sprigs. Your field grows it, I'm told. Nobody else's does any more.","\n",{"->":".^.^.^"},null],"c-4":["\n","^Maren: Keep your feet dry.","\n","end",null]}],null],"herbs_offer":[["^Maren: My shelves are nearly bare. The Blight took every Healroot patch from here to the river.","\n","^Maren: Three sprigs would keep me brewing for a week. I'll pay in draughts, which is better than coin out there.","\n","ev","str","^I'll bring you some.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Not right now.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","ev","str","^quest_herbsformaren","/str",{"x()":"start_quest","exArgs":1},"pop","/ev","\n","^Maren: Bless you. Not too ripe, not too green.","\n",{"->":".^.^.g-0"},null],"c-1":["\n","^Maren: Then I'll make do. Ask me again if your field is generous.","\n",{"->":".^.^.g-0"},null],"g-0":[{"->":"maren.menu"},null]}],null],"herbs_done":["^Maren: Oh, look at them. Green to the root.","\n","ev","str","^quest_herbsformaren","/str",{"x()":"turn_in_quest","exArgs":1},"pop","/ev","\n","^Maren: Take these. And come to me before you go anywhere stupid, not after.","\n",{"->":".^.^.menu"},null],"#f":1}],"tobin":["ev","str","^quest_wolvesatthefold","/str",{"x()":"quest_state","exArgs":1},"str","^ready","/str","==","/ev",[{"->":".^.b","c":true},{"b":["^ ",{"->":"tobin.wolves_done"},{"->":"tobin.11"},null]}],"nop","\n",["ev",{"CNT?":".^.^"},1,"==","/ev",{"->":".^.b","c":true},{"b":["\n","^Tobin: You're the one with the field that actually grows? I've been watching it over the fence. Sorry. It's just...","\n","^Tobin: Mine went grey two summers back. I'm Tobin. I help where I can, which is mostly carrying things.","\n",{"->":"tobin.17"},null]}],["ev",{"x()":"weather"},"str","^Rain","/str","==","/ev",{"->":".^.b","c":true},{"b":["\n","^Tobin: ",["ev","visit",2,"seq","/ev","ev","du",0,"==","/ev",{"->":".^.s0","c":true},"ev","du",1,"==","/ev",{"->":".^.s1","c":true},"nop",{"s0":["pop","^Rain! Your field's drinking well today, ","ev",{"x()":"player_name"},"out","/ev","^.",{"->":".^.^.17"},null],"s1":["pop","^Don't mind me, I just like standing in it.",{"->":".^.^.17"},null],"#f":5}],"\n",{"->":"tobin.17"},null]}],["ev","str","^quest_wolvesatthefold","/str",{"x()":"quest_state","exArgs":1},"str","^done","/str","==","/ev",{"->":".^.b","c":true},{"b":["\n","^Tobin: ",["ev","visit",2,"seq","/ev","ev","du",0,"==","/ev",{"->":".^.s0","c":true},"ev","du",1,"==","/ev",{"->":".^.s1","c":true},"nop",{"s0":["pop","ev",{"x()":"player_name"},"out","/ev","^! Haven't heard a howl since you went up there.",{"->":".^.^.17"},null],"s1":["pop","^The goats are gone, but at least nobody else will be.",{"->":".^.^.17"},null],"#f":5}],"\n",{"->":"tobin.17"},null]}],[{"->":".^.b"},{"b":["\n","^Tobin: ",["ev","visit",3,"seq","/ev","ev","du",0,"==","/ev",{"->":".^.s0","c":true},"ev","du",1,"==","/ev",{"->":".^.s1","c":true},"ev","du",2,"==","/ev",{"->":".^.s2","c":true},"nop",{"s0":["pop","^Morning, ","ev",{"x()":"player_name"},"out","/ev","^! Or whatever it is.",{"->":".^.^.23"},null],"s1":["pop","^Your turnips look better than anything I ever grew.",{"->":".^.^.23"},null],"s2":["pop","^Heard the wolves again last night.",{"->":".^.^.23"},null],"#f":5}],"\n",{"->":"tobin.17"},null]}],"nop","\n",{"->":".^.menu"},{"menu":[["ev","str","^Any advice for a farmer?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^You look worried.","/str","str","^quest_wolvesatthefold","/str",{"x()":"quest_state","exArgs":1},"str","^inactive","/str","==","/ev",{"*":".^.c-1","flg":5},"ev","str","^About the wolves...","/str","str","^quest_wolvesatthefold","/str",{"x()":"quest_state","exArgs":1},"str","^active","/str","==","/ev",{"*":".^.c-2","flg":5},"ev","str","^Goodbye.","/str","/ev",{"*":".^.c-3","flg":4},{"c-0":["\n",{"->":"tobin.tips"},null],"c-1":["\n",{"->":"tobin.wolves_offer"},null],"c-2":["\n","^Tobin: The pack dens in the north-west woods, past the houses. Three of them. They come at you from behind, so keep turning.","\n",{"->":".^.^.^"},null],"c-3":["\n","^Tobin: Mind the fence, it's the only one we've got.","\n","end",null]}],null],"tips":["ev",{"x()":"season"},"str","^Winter","/str","==","/ev",[{"->":".^.b","c":true},{"b":["\n","^Tobin: Only frost kale takes the cold. Everything else dies at the first frost, so harvest before winter comes.","\n",{"->":"tobin.menu"},{"->":".^.^.^.8"},null]}],"nop","\n","ev",{"x()":"season"},"str","^Autumn","/str","==","/ev",[{"->":".^.b","c":true},{"b":["\n","^Tobin: Pumpkins are an autumn crop. Plant them early in the season: they take their time.","\n",{"->":"tobin.menu"},{"->":".^.^.^.18"},null]}],"nop","\n","^Tobin: ",["ev","visit",4,"seq","/ev","ev","du",0,"==","/ev",{"->":".^.s0","c":true},"ev","du",1,"==","/ev",{"->":".^.s1","c":true},"ev","du",2,"==","/ev",{"->":".^.s2","c":true},"ev","du",3,"==","/ev",{"->":".^.s3","c":true},"nop",{"s0":["pop","^Rain does your watering for you. Don't waste a morning carrying buckets when the sky's doing it.",{"->":".^.^.29"},null],"s1":["pop","^Healroot keeps giving after you pick it. Turnips don't. Plant accordingly.",{"->":".^.^.29"},null],"s2":["pop","^Two days dry and a crop wilts. Three and it's gone. Ask me how I know.",{"->":".^.^.29"},null],"s3":["pop","^Sleep in your own bed and the field grows while you do. Best trade in the Hollows.",{"->":".^.^.29"},null],"#f":5}],"\n",{"->":".^.^.menu"},null],"wolves_offer":[["^Tobin: Wolves. A pack moved into the north-west woods when the Blight drove the deer out.","\n","^Tobin: They took the last of Maren's goats. Next it'll be someone walking home late.","\n","ev","str","^I'll deal with them.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Not now.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","ev","str","^quest_wolvesatthefold","/str",{"x()":"start_quest","exArgs":1},"pop","/ev","\n","^Tobin: Three of them. Watch your back. I mean that literally.","\n",{"->":".^.^.g-0"},null],"c-1":["\n","^Tobin: No, that's fair. They're not your goats.","\n",{"->":".^.^.g-0"},null],"g-0":[{"->":"tobin.menu"},null]}],null],"wolves_done":["^Tobin: All three? Maren will cry. Happily, I mean.","\n","ev","str","^quest_wolvesatthefold","/str",{"x()":"turn_in_quest","exArgs":1},"pop","/ev","\n","^Tobin: Take these seeds. I was saving them for a field I don't have any more.","\n",{"->":".^.^.menu"},null],"#f":1}],"hale":["ev","str","^quest_shieldwall","/str",{"x()":"quest_state","exArgs":1},"str","^ready","/str","==","/ev",[{"->":".^.b","c":true},{"b":["^ ",{"->":"hale.shield_done"},{"->":"hale.11"},null]}],"nop","\n","ev","str","^quest_deadwood","/str",{"x()":"quest_state","exArgs":1},"str","^ready","/str","==","/ev",[{"->":".^.b","c":true},{"b":["^ ",{"->":"hale.brute_done"},{"->":"hale.24"},null]}],"nop","\n",["ev",{"CNT?":"hale"},1,"==","/ev",{"->":".^.b","c":true},{"b":["\n","^Hale: Halt. ...Ah, the farmer. ","ev",{"x()":"player_name"},"out","/ev","^, isn't it? Brenna told me about you.","\n","^Hale: Captain Hale. The watch is me, a spear, and a lot of dark. I keep the night; you keep your field.","\n",{"->":"hale.31"},null]}],["ev",{"x()":"hurt"},"/ev",{"->":".^.b","c":true},{"b":["\n","^Hale: You're hurt, ","ev",{"x()":"player_name"},"out","/ev","^. Go home. The night will still be here tomorrow.","\n",{"->":"hale.31"},null]}],["ev",{"x()":"weather"},"str","^Rain","/str","==","/ev",{"->":".^.b","c":true},{"b":["\n","^Hale: Rain keeps the bandits in their tents. Mostly.","\n",{"->":"hale.31"},null]}],["ev",{"x()":"standing_tier"},2,">=","/ev",{"->":".^.b","c":true},{"b":["\n","^Hale: ",["ev","visit",2,"seq","/ev","ev","du",0,"==","/ev",{"->":".^.s0","c":true},"ev","du",1,"==","/ev",{"->":".^.s1","c":true},"nop",{"s0":["pop","ev",{"x()":"player_name"},"out","/ev","^. The Hollows sleep easier with you about.",{"->":".^.^.17"},null],"s1":["pop","^Evening, ","ev",{"x()":"player_name"},"out","/ev","^. Anything I should know?",{"->":".^.^.17"},null],"#f":5}],"\n",{"->":"hale.31"},null]}],[{"->":".^.b"},{"b":["\n","^Hale: ",["ev","visit",3,"seq","/ev","ev","du",0,"==","/ev",{"->":".^.s0","c":true},"ev","du",1,"==","/ev",{"->":".^.s1","c":true},"ev","du",2,"==","/ev",{"->":".^.s2","c":true},"nop",{"s0":["pop","^Quiet night so far. Don't jinx it.",{"->":".^.^.23"},null],"s1":["pop","^Evening. Keep your blade loose.",{"->":".^.^.23"},null],"s2":["pop","^You're out late, ","ev",{"x()":"player_name"},"out","/ev","^. Good. So am I.",{"->":".^.^.23"},null],"#f":5}],"\n",{"->":"hale.31"},null]}],"nop","\n",{"->":".^.menu"},{"menu":[["ev","str","^Need a hand with the bandits?","/str","str","^quest_shieldwall","/str",{"x()":"quest_state","exArgs":1},"str","^inactive","/str","==","/ev",{"*":".^.c-0","flg":5},"ev","str","^About the shieldbearer...","/str","str","^quest_shieldwall","/str",{"x()":"quest_state","exArgs":1},"str","^active","/str","==","/ev",{"*":".^.c-1","flg":5},"ev","str","^What's out in the dead wood?","/str","str","^quest_shieldwall","/str",{"x()":"quest_state","exArgs":1},"str","^done","/str","==","str","^quest_deadwood","/str",{"x()":"quest_state","exArgs":1},"str","^inactive","/str","==","&&","/ev",{"*":".^.c-2","flg":5},"ev","str","^About the thing in the dead wood...","/str","str","^quest_deadwood","/str",{"x()":"quest_state","exArgs":1},"str","^active","/str","==","/ev",{"*":".^.c-3","flg":5},"ev","str","^Goodbye.","/str","/ev",{"*":".^.c-4","flg":4},{"c-0":["\n",{"->":"hale.shield_offer"},null],"c-1":["\n","^Hale: Don't hit the shield, hit the man. Get round his side, or hammer the shield till his arm gives.","\n",{"->":".^.^.^"},null],"c-2":["\n",{"->":"hale.brute_offer"},null],"c-3":["\n","^Hale: It only walks at night. It doesn't flinch mid-swing, so don't trade blows. Dodge, then punish.","\n",{"->":".^.^.^"},null],"c-4":["\n","^Hale: Stay in the light.","\n","end",null]}],null],"shield_offer":[["^Hale: There's a deserter at the camp with a tower shield. Held a shield wall at the river, by the look of him.","\n","^Hale: Arrows bounce off, my spear bounces off. Put him down and the rest lose their nerve.","\n","ev","str","^I'll take him on.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Not yet.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","ev","str","^quest_shieldwall","/str",{"x()":"start_quest","exArgs":1},"pop","/ev","\n","^Hale: Side or back. Never the front.","\n",{"->":".^.^.g-0"},null],"c-1":["\n","^Hale: Wise. Come back when you're ready to bleed a little.","\n",{"->":".^.^.g-0"},null],"g-0":[{"->":"hale.menu"},null]}],null],"shield_done":["^Hale: Heard the camp's gone quiet. That was you.","\n","ev","str","^quest_shieldwall","/str",{"x()":"turn_in_quest","exArgs":1},"pop","/ev","\n","^Hale: The town owes you. I'll make sure they know it.","\n",{"->":"hale.menu"},null],"brute_offer":[["^Hale: Past the camp, where the trees went black, something walks at night. Big. Wrong. Blight in its veins.","\n","^Hale: I've watched it from the road. It hasn't come to town yet. Yet.","\n","ev","str","^I'll hunt it.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^That sounds like a bad idea.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","ev","str","^quest_deadwood","/str",{"x()":"start_quest","exArgs":1},"pop","/ev","\n","^Hale: Only at night. Bring draughts. And bring yourself back.","\n",{"->":".^.^.g-0"},null],"c-1":["\n","^Hale: It is. That's why I'm asking you and not doing it.","\n",{"->":".^.^.g-0"},null],"g-0":[{"->":"hale.menu"},null]}],null],"brute_done":["^Hale: It's dead? You're sure? ...You smell like it's dead.","\n","ev","str","^quest_deadwood","/str",{"x()":"turn_in_quest","exArgs":1},"pop","/ev","\n","^Hale: Take the purse. And sleep. Someone in this town should.","\n",{"->":"hale.menu"},null],"#f":1}]}],"listDefs":{}}