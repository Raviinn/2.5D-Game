du",0,"==","/ev",{"->":".^.s0","c":true},"ev","du",1,"==","/ev",{"->":".^.s1","c":true},"ev","du",2,"==","/ev",{"->":".^.s2","c":true},"ev","du",3,"==","/ev",{"->":".^.s3","c":true},"nop",{"s0":["pop","^Back again, friend.",{"->":".^.^.29"},null],"s1":["pop","^Ah, the farmer with the green field.",{"->":".^.^.29"},null],"s2":["pop","^Still in one piece? Good.",{"->":".^.^.29"},null],"s3":["pop","^Business is slow. Talk is free.",{"->":".^.^.29"},null],"#f":5}],"\n",{"->":"oswin.44"},null]}],"nop","\n",{"->":".^.menu"},{"menu":[["ev","str","^I'd like to trade.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^What happened to this land?","/str","str","^quest_bandittrouble","/str",{"x()":"quest_state","exArgs":1},"str","^inactive","/str","==","/ev",{"*":".^.c-1","flg":5},"ev","str","^About those bandits...","/str","str","^quest_bandittrouble","/str",{"x()":"quest_state","exArgs":1},"str","^active","/str","==","/ev",{"*":".^.c-2","flg":5},"ev","str","^About Brenna's ash...","/str","str","^quest_bandittrouble","/str",{"x()":"quest_state","exArgs":1},"str","^done","/str","==","str","^quest_rootsoftheblight","/str",{"x()":"quest_state","exArgs":1},"str","^inactive","/str","==","&&","/ev",{"*":".^.c-3","flg":5},"ev","str","^Need anything?","/str","str","^quest_tasteofhome","/str",{"x()":"quest_state","exArgs":1},"str","^inactive","/str","==","/ev",{"*":".^.c-4","flg":5},"ev","str","^About those turnips...","/str","str","^quest_tasteofhome","/str",{"x()":"quest_state","exArgs":1},"str","^active","/str","==","/ev",{"*":".^.c-5","flg":5},"ev","str","^How does the town see me?","/str","/ev",{"*":".^.c-6","flg":4},"ev","str","^Goodbye.","/str","/ev",{"*":".^.c-7","flg":4},{"c-0":["\n","^Oswin: Let's see what you've got.","\n","ev",{"x()":"open_shop"},"pop","/ev","\n","end",null],"c-1":["\n",{"->":"oswin.lore"},null],"c-2":["\n","^Oswin: Three of them, out past the houses to the north-east. Watch for the wind-up before they swing.","\n",{"->":".^.^.^"},null],"c-3":["\n",{"->":"oswin.brenna_offer"},null],"c-4":["\n",{"->":"oswin.turnips_offer"},null],"c-5":["\n","^Oswin: Five turnips. Fresh, mind you. I can't sell what doesn't exist.","\n",{"->":".^.^.^"},null],"c-6":["\n",{"->":"oswin.standing_talk"},null],"c-7":["\n","^Oswin: Mind the road.","\n","end",null]}],null],"lore":[["^Oswin: The war ended in a single night. The sky went white, and when it faded, the soil had turned to ash.","\n","^Oswin: Nothing grows out here anymore. Nothing... except on your field. Nobody knows why.","\n","^Oswin: And now deserters have taken to the hills. They raid anyone who still has food.","\n","ev","str","^I'll deal with them.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Not my problem.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","ev","str","^quest_bandittrouble","/str",{"x()":"start_quest","exArgs":1},"pop","/ev","\n","^Oswin: You'd do that? Clear out three of them and I'll make it worth your while.","\n",{"->":".^.^.g-0"},null],"c-1":["\n","^Oswin: It will be, once they smell your crops.","\n",{"->":".^.^.g-0"},null],"g-0":[{"->":"oswin.menu"},null]}],null],"bandits_done":["^Oswin: Word travels fast. Three fewer bandits on the road!","\n","ev","str","^quest_bandittrouble","/str",{"x()":"turn_in_quest","exArgs":1},"pop","/ev","\n",{"->":".^.^.brenna_offer"},null],"brenna_offer":[["^Oswin: There's something else. Brenna at the forge found ash in her quench barrel that... moves.","\n","^Oswin: She won't talk about it with just anyone. But she'll talk to someone who's bled for this town.","\n","ev","str","^I'll go and see her.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Not now.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","ev","str","^quest_rootsoftheblight","/str",{"x()":"start_quest","exArgs":1},"pop","/ev","\n","^Oswin: Good. Mind what she shows you.","\n",{"->":".^.^.g-0"},null],"c-1":["\n","^Oswin: When you're ready, then. It isn't going anywhere. Unfortunately.","\n",{"->":".^.^.g-0"},null],"g-0":[{"->":"oswin.menu"},null]}],null],"standing_talk":["ev",{"x()":"standing_tier"},"/ev",{"temp=":"tier"},"\n","ev",{"VAR?":"tier"},"/ev",["du","ev",0,"==","/ev",{"->":".^.b","c":true},{"b":["pop","\n","^Oswin: Honestly? You're a stranger with a green field. Folk are curious, and a little scared.","\n","^Oswin: Help people, trade fairly, keep the road safe. They'll warm to you, and so will my prices.","\n",{"->":".^.^.^.13"},null]}],["du","ev",1,"==","/ev",{"->":".^.b","c":true},{"b":["pop","\n","^Oswin: People know your face now. Some of them even wave.","\n","^Oswin: Keep at it. Folk who are trusted here get first pick of the work on the board.","\n",{"->":".^.^.^.13"},null]}],["du","ev",2,"==","/ev",{"->":".^.b","c":true},{"b":["pop","\n","^Oswin: You're trusted here. The guards even posted a patrol job on the board for people like you.","\n",{"->":".^.^.^.13"},null]}],["du","ev",3,"==","/ev",{"->":".^.b","c":true},{"b":["pop","\n","^Oswin: A friend of the Hollows, that's what you are. My best prices are yours.","\n",{"->":".^.^.^.13"},null]}],[{"->":".^.b"},{"b":["pop","\n","^Oswin: The refugees tell stories about you around the fire. The Hero of the Hollows, they call you.","\n","^Oswin: Don't let it go to your head.","\n",{"->":".^.^.^.13"},null]}],"nop","\n",{"->":".^.^.menu"},null],"trusted_thanks":["^Oswin: There you are! People have been saying your name at the well, and kindly, for once.","\n","^Oswin: The refugees, the guards, even Brenna. You've earned this town's trust.","\n","^Oswin: Here. Bread from the first proper flour we've had in months, and a draught for the road.","\n","ev","str","^item_bread","/str",2,{"x()":"give_item","exArgs":2},"pop","/ev","\n","ev","str","^item_healingdraught","/str",1,{"x()":"give_item","exArgs":2},"pop","/ev","\n","^Oswin: And you'll find my prices a little kinder from now on.","\n",{"->":".^.^.menu"},{"#f":1}],"turnips_offer":[["^Oswin: Bread's running low and the refugees are hungry. Bring me five turnips and I'll pay above market.","\n","ev","str","^I'll grow them.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Maybe later.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","ev","str","^quest_tasteofhome","/str",{"x()":"start_quest","exArgs":1},"pop","/ev","\n","^Oswin: Bless you.","\n",{"->":".^.^.g-0"},null],"c-1":["\n","^Oswin: The offer stands.","\n",{"->":".^.^.g-0"},null],"g-0":[{"->":"oswin.menu"},null]}],null],"turnips_done":["^Oswin: Turnips! Real ones, with dirt on them!","\n","ev","str","^quest_tasteofhome","/str",{"x()":"turn_in_quest","exArgs":1},"pop","/ev","\n","^Oswin: Take these seeds as well. Healroot. You'll want it out there.","\n",{"->":".^.^.menu"},null],"#f":1}],"brenna":["ev","str","^quest_scraprun","/str",{"x()":"quest_state","exArgs":1},"str","^ready","/str","==","/ev",[{"->":".^.b","c":true},{"b":["^ ",{"->":"brenna.scrap_done"},{"->":"brenna.11"},null]}],"nop","\n","ev","str","^quest_rootsoftheblight","/str",{"x()":"quest_state","exArgs":1},"str","^active","/str","==","str","^quest_rootsoftheblight","/str",{"x()":"quest_state","exArgs":1},"str","^ready","/str","==","||","/ev",[{"->":".^.b","c":true},{"b":["^ ",{"->":"brenna.roots"},{"->":"brenna.33"},null]}],"nop","\n","ev",{"x()":"standing_tier"},3,">=",{"CNT?":".^.friend_gift"},"!","&&","/ev",[{"->":".^.b","c":true},{"b":["^ ",{"->":"brenna.friend_gift"},{"->":"brenna.44"},null]}],"nop","\n","ev",{"CNT?":".^"},1,"==","/ev",[{"->":".^.b","c":true},{"b":["\n","^Brenna: You're the one with the green field. Everyone's talking about it.","\n","^Brenna: I'm Brenna. If it cuts or it stops a cut, I make it.","\n",{"->":"brenna.53"},null]}],[{"->":".^.b"},{"b":["\n","^Brenna: ",["ev","visit",3,"seq","/ev","ev","du",0,"==","/ev",{"->":".^.s0","c":true},"ev","du",1,"==","/ev",{"->":".^.s1","c":true},"ev","du",2,"==","/ev",{"->":".^.s2","c":true},"nop",{"s0":["pop","^Forge is hot. Make it quick.",{"->":".^.^.23"},null],"s1":["pop","^You again. Need steel?",{"->":".^.^.23"},null],"s2":["pop","^Mind the sparks.",{"->":".^.^.23"},null],"#f":5}],"\n",{"->":"brenna.53"},null]}],"nop","\n",{"->":".^.menu"},{"menu":[["ev","str","^Show me your wares.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Any work?","/str","str","^quest_scraprun","/str",{"x()":"quest_state","exArgs":1},"str","^inactive","/str","==","/ev",{"*":".^.c-1","flg":5},"ev","str","^About the scrap...","/str","str","^quest_scraprun","/str",{"x()":"quest_state","exArgs":1},"str","^active","/str","==","/ev",{"*":".^.c-2","flg":5},"ev","str","^Goodbye.","/str","/ev",{"*":".^.c-3","flg":4},{"c-0":["\n","ev",{"x()":"open_shop"},"pop","/ev","\n","end",null],"c-1":["\n",{"->":"brenna.scrap_offer"},null],"c-2":["\n","^Brenna: Four pieces. Bandits carry it around like trophies.","\n",{"->":".^.^.^"},null],"c-3":["\n","end",null]}],null],"roots":["ev","str","^quest_rootsoftheblight","/str",{"x()":"quest_state","exArgs":1},"str","^ready","/str","==","/ev",[{"->":".^.b","c":true},{"b":["^ ",{"->":"brenna.roots_done"},{"->":".^.^.^.11"},null]}],"nop","\n","ev",{"CNT?":".^"},1,">","/ev",[{"->":".^.b","c":true},{"b":["\n","^Brenna: Still waiting on that Healroot. Just one sprig.","\n",{"->":"brenna.menu"},{"->":".^.^.^.19"},null]}],"nop","\n","^Brenna: Oswin sent you? Good. Look at this.","\n","^The ash in the barrel shivers, then slides toward the green thread on your sleeve.","\n","^Brenna: It crawls toward anything that grows. I've never seen ash do that.","\n","ev","str","^quest_rootsoftheblight","/str",0,{"x()":"complete_objective","exArgs":2},"pop","/ev","\n","ev","str","^quest_rootsoftheblight","/str",{"x()":"quest_state","exArgs":1},"str","^ready","/str","==","/ev",[{"->":".^.b","c":true},{"b":["\n","^Brenna: And you've brought Healroot already? Then let's not wait.","\n",{"->":"brenna.roots_done"},{"->":".^.^.^.47"},null]}],"nop","\n","^Brenna: Bring me a sprig of Healroot from your field. I want to see what the ash does with it.","\n",{"->":".^.^.menu"},{"#f":1}],"roots_done":["^Brenna: Let's see...","\n","^You drop the Healroot into the barrel. The ash recoils from it, like a hand from a flame.","\n","ev","str","^quest_rootsoftheblight","/str",{"x()":"turn_in_quest","exArgs":1},"pop","/ev","\n","^Brenna: Your soil isn't just untouched by the Blight. It's fighting it.","\n","^Brenna: Keep that to yourself. There are people who'd burn your field to the ground for a secret like that.","\n",{"->":".^.^.menu"},null],"friend_gift":["^Brenna: Wait. Before you go.","\n","^She lifts a helm from the rack. The iron is plain, but the rivets are perfect.","\n","^Brenna: Folk keep telling me you're the reason the road's quiet. Least I can do is keep your head on.","\n","ev","str","^armor_ironhelm","/str",1,{"x()":"give_item","exArgs":2},"pop","/ev","\n","^Brenna: Don't get it dented on my account.","\n",{"->":".^.^.menu"},{"#f":1}],"scrap_offer":[["^Brenna: Iron's scarce since the war. Bring me four pieces of scrap and I'll pay properly.","\n","ev","str","^I'll find some.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Not right now.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","ev","str","^quest_scraprun","/str",{"x()":"start_quest","exArgs":1},"pop","/ev","\n","^Brenna: Good. Bandits carry it around like trophies.","\n",{"->":".^.^.g-0"},null],"c-1":["\n","^Brenna: Suit yourself. The offer stands.","\n",{"->":".^.^.g-0"},null],"g-0":[{"->":"brenna.menu"},null]}],null],"scrap_done":["^Brenna: That's good iron. Here.","\n","ev","str","^quest_scraprun","/str",{"x()":"turn_in_quest","exArgs":1},"pop","/ev","\n",{"->":".^.^.menu"},null],"#f":1}]}],"listDefs":{}}